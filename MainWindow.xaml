<Window x:Class="WavelogButler.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Wavelog 管家" Icon="Assets/wavelog-butler.ico" Width="1280" Height="860" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="13" Background="#F3F5FA" Foreground="#17243D">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#315EEB"/>
  <Style TargetType="Button"><Setter Property="Background" Value="#EAF0FF"/><Setter Property="Foreground" Value="#315EEB"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderBrush" Value="#DCE3EF"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="24"/><Setter Property="Margin" Value="0,0,0,18"/><Setter Property="BorderBrush" Value="#E6EBF3"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#71809B"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Info" TargetType="TextBox"><Setter Property="IsReadOnly" Value="True"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="15"/></Style>
 </Window.Resources>
 <Grid Background="#F3F5FA"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#17243D"><DockPanel Margin="22,32"><StackPanel DockPanel.Dock="Top"><TextBlock Text="WAVELOG" Foreground="White" FontSize="23" FontWeight="Bold"/><TextBlock Text="QSL  集中寄卡管家" Foreground="#91A4C6" Margin="0,8,0,38"/><Button Content="通联查询" Click="ShowSearch" Margin="0,0,0,12"/><Button Content="日志管理" Click="ShowAccounts" Margin="0,0,0,12"/><Button Content="资料查询设置" Click="ConfigureLookup" Margin="0,0,0,12"/></StackPanel><StackPanel VerticalAlignment="Bottom"><TextBlock Text="LOCAL FIRST" Foreground="#91A4C6" FontSize="11"/><TextBlock Text="SQLite 本地日志库&#10;只读连接 Wavelog" Foreground="#CBD7ED" Margin="0,8,0,0" LineHeight="22"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="30,26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,22"><TextBlock Text="通联与寄卡" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="每一次通联，都值得好好收藏。" Foreground="#71809B" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
   <ScrollViewer x:Name="SearchPage" Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="搜索一个友台，查看所有我方台站的通联" Style="{StaticResource Caption}"/><DockPanel><Button DockPanel.Dock="Right" Content="搜索并查询资料" Background="#315EEB" Foreground="White" Click="SearchClick" Margin="12,0,0,0"/><TextBox x:Name="CallInput" FontSize="19" KeyDown="SearchKey" ToolTip="输入完整呼号；含 /P 等后缀时精确匹配"/></DockPanel></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="QRZ ↗" Click="OpenQrz"/><Button Content="Club Log ↗" Click="OpenClubLog"/></StackPanel><TextBlock x:Name="FriendCall" Text="友台资料" FontSize="25" FontWeight="SemiBold"/></DockPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.8*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.6*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0"><TextBlock Text="国家 / 地区" Style="{StaticResource Caption}"/><TextBox x:Name="Country" Text="等待查询" Style="{StaticResource Info}"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,20,0"><TextBlock Text="电子邮箱" Style="{StaticResource Caption}"/><TextBox x:Name="Email" Text="等待查询" Style="{StaticResource Info}"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="完整邮寄地址 · 寄出前请核对" Style="{StaticResource Caption}"/><TextBox x:Name="Address" Text="等待查询" Style="{StaticResource Info}" AcceptsReturn="True" MinLines="3" MaxLines="2147483647" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"/></StackPanel>
     </Grid><TextBlock x:Name="Manager" Foreground="#315EEB" Margin="0,18,0,0" TextWrapping="Wrap"/><TextBlock x:Name="LookupStatus" Text="搜索会同时读取本地通联并联网查询资料。" Foreground="#71809B" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <DockPanel Margin="0,2,0,16"><Button Content="导出寄卡清单" DockPanel.Dock="Right" Click="Export"/><TextBlock x:Name="Summary" Text="按我方呼号分组 · 没有通联的账户也会保留" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <StackPanel x:Name="Groups"/>
   </StackPanel></ScrollViewer>
   <ScrollViewer x:Name="AccountsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="日志来源" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="日志永久保存在本机数据库；远端不再返回的记录会保留并标记待核对。" Margin="0,12,0,20" TextWrapping="Wrap" Foreground="#71809B"/><WrapPanel><Button x:Name="AddAccountButton" Content="添加账户" Click="AddAccount"/><Button x:Name="SyncButton" Content="同步全部日志" Click="Sync"/><Button x:Name="CancelButton" Content="取消同步" Click="CancelSync" IsEnabled="False"/><Button Content="备份数据库" Click="Backup"/></WrapPanel></StackPanel></Border><StackPanel x:Name="AccountCards"/></StackPanel></ScrollViewer>
   <TextBlock x:Name="Status" Grid.Row="2" Text="准备就绪 · 本地 SQLite 数据库" Foreground="#71809B" Margin="0,16,0,0" TextWrapping="Wrap"/>
  </Grid>
 </Grid>
</Window>
